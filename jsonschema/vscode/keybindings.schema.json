{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VSCode Keybindings",
  "description": "Schema for VSCode-style keybindings.json",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "key": {
        "type": "string",
        "description": "Key or key sequence (separated by space)"
      },
      "command": {
        "description": "The command to execute",
        "type": "string",
        "oneOf": [
          {
            "const": "editor.action.goToTypeDefinition",
            "description": "Go to type definition"
          },
          {
            "const": "editor.action.referenceSearch.trigger",
            "description": "Trigger reference search"
          },
          {
            "const": "editor.action.goToImplementation",
            "description": "Go to implementation"
          },
          { "const": "editor.action.rename", "description": "Rename symbol" },
          { "const": "editor.action.quickFix", "description": "Quick fix" },
          {
            "const": "workbench.action.files.save",
            "description": "Save file"
          },

          { "const": "editor.toggleFold", "description": "Toggle fold" },
          { "const": "editor.foldAll", "description": "Fold all" },

          {
            "const": "workbench.action.splitEditorRight",
            "description": "Split editor right"
          },
          {
            "const": "workbench.action.splitEditorLeft",
            "description": "Split editor left"
          },
          {
            "const": "workbench.action.splitEditorUp",
            "description": "Split editor up"
          },
          {
            "const": "workbench.action.splitEditorDown",
            "description": "Split editor down"
          },
          {
            "const": "workbench.action.closeEditorsInGroup",
            "description": "Close active editor group"
          },
          {
            "const": "workbench.action.increaseViewWidth",
            "description": "Increase view width"
          },
          {
            "const": "workbench.action.decreaseViewWidth",
            "description": "Decrease view width"
          },
          {
            "const": "workbench.action.increaseViewHeight",
            "description": "Increase view height"
          },
          {
            "const": "workbench.action.decreaseViewHeight",
            "description": "Decrease view height"
          },

          {
            "const": "workbench.action.navigateLeft",
            "description": "Navigate left"
          },
          {
            "const": "workbench.action.navigateRight",
            "description": "Navigate right"
          },
          {
            "const": "workbench.action.navigateUp",
            "description": "Navigate up"
          },
          {
            "const": "workbench.action.navigateDown",
            "description": "Navigate down"
          },

          {
            "const": "workbench.explorer.fileView.focus",
            "description": "Focus file explorer"
          },
          {
            "const": "workbench.action.closeSidebar",
            "description": "Close sidebar"
          },

          {
            "const": "workbench.view.extensions",
            "description": "Open extensions view"
          },

          {
            "const": "workbench.action.findInFiles",
            "description": "Find in files"
          },
          {
            "const": "search.action.focusSearchList",
            "description": "Focus search results"
          },
          {
            "const": "workbench.action.quickOpen",
            "description": "Quick open file"
          },

          {
            "const": "runCommands",
            "description": "Run multiple commands sequentially"
          },

          {
            "const": "workbench.action.chat.openagent",
            "description": "Open chat agent"
          },
          {
            "const": "workbench.action.toggleAuxiliaryBar",
            "description": "Toggle auxiliary bar"
          },
          {
            "const": "workbench.action.chat.attachSelection",
            "description": "Attach selection to chat"
          },
          {
            "const": "workbench.action.chat.attachContext",
            "description": "Attach context to chat"
          },

          {
            "const": "workbench.action.terminal.toggleTerminal",
            "description": "Toggle terminal"
          },
          {
            "const": "workbench.action.togglePanel",
            "description": "Toggle panel"
          },
          {
            "const": "workbench.action.terminal.kill",
            "description": "Kill terminal"
          },
          {
            "const": "workbench.action.terminal.new",
            "description": "New terminal"
          },
          {
            "const": "workbench.action.terminal.split",
            "description": "Split terminal"
          },
          {
            "const": "workbench.action.terminal.unsplit",
            "description": "Unsplit terminal"
          },
          {
            "const": "workbench.action.terminal.resizePaneLeft",
            "description": "Resize terminal left"
          },
          {
            "const": "workbench.action.terminal.resizePaneRight",
            "description": "Resize terminal right"
          },
          {
            "const": "workbench.action.terminal.resizePaneUp",
            "description": "Resize terminal up"
          },
          {
            "const": "workbench.action.terminal.resizePaneDown",
            "description": "Resize terminal down"
          },
          {
            "const": "workbench.action.terminal.focusPreviousPane",
            "description": "Focus previous terminal pane"
          },
          {
            "const": "workbench.action.terminal.focusNextPane",
            "description": "Focus next terminal pane"
          },
          {
            "const": "workbench.action.terminal.focusAtIndex1",
            "description": "Focus terminal at index 1"
          },
          {
            "const": "workbench.action.terminal.focusAtIndex2",
            "description": "Focus terminal at index 2"
          },
          {
            "const": "workbench.action.terminal.focusAtIndex3",
            "description": "Focus terminal at index 3"
          },
          {
            "const": "workbench.action.terminal.focusAtIndex4",
            "description": "Focus terminal at index 4"
          },
          {
            "const": "workbench.action.terminal.focusAtIndex5",
            "description": "Focus terminal at index 5"
          },
          {
            "const": "workbench.action.terminal.focusAtIndex6",
            "description": "Focus terminal at index 6"
          },
          {
            "const": "workbench.action.terminal.focusAtIndex7",
            "description": "Focus terminal at index 7"
          },
          {
            "const": "workbench.action.terminal.focusAtIndex8",
            "description": "Focus terminal at index 8"
          },
          {
            "const": "workbench.action.terminal.focusAtIndex9",
            "description": "Focus terminal at index 9"
          },
          {
            "const": "workbench.action.toggleMaximizedPanel",
            "description": "Toggle maximized panel"
          },

          {
            "const": "vscode-neovim.send",
            "description": "Send keys to Neovim"
          }
        ]
      },
      "when": {
        "type": "string",
        "description": "Condition when the key is active"
      },
      "args": {
        "description": "Arguments for the command",
        "type": ["object", "array", "string", "number", "boolean", "null"]
      }
    },
    "required": ["key", "command"],
    "additionalProperties": false
  }
}
